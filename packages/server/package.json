    "resend": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
