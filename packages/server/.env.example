# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all (dev only)
ALLOWED_ORIGINS=*

# ── Email provider ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend            # resend | smtp

# --- Resend (used when EMAIL_PROVIDER=resend) ---------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- SMTP (used when EMAIL_PROVIDER=smtp) ------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=supersecret

# ── Email addressing ──────────────────────────────────────────────────────────
MAIL_TO=you@example.com
MAIL_FROM=noreply@example.com
MAIL_SUBJECT_PREFIX=[Contact]

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60000

# ── Cloudflare Turnstile (optional — omit to disable) ─────────────────────────
# TURNSTILE_SECRET=0x4AAAAAAA...
